{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts/bridge.mjs')).href)).then(m=>m.main(['codex','hook'])).then(c=>{process.exitCode=c}).catch(()=>{process.exitCode=0})\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts/bridge.mjs')).href)).then(m=>m.main(['codex','hook'])).then(c=>{process.exitCode=c}).catch(()=>{process.exitCode=0})\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts/bridge.mjs')).href)).then(m=>m.main(['codex','hook'])).then(c=>{process.exitCode=c}).catch(()=>{process.exitCode=0})\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts/bridge.mjs')).href)).then(m=>m.main(['codex','hook'])).then(c=>{process.exitCode=c}).catch(()=>{process.exitCode=0})\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/bridge.mjs\" cursor hook",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/bridge.mjs\" cursor hook",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/bridge.mjs\" cursor hook",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/bridge.mjs\" cursor hook",
        "timeout": 10
      }
    ]
  }
}

{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "plugins/**/{bridge,native}.mjs",
        "plugins/*/greatping/index.js",
        "plugins/shared/{opencode,pi}.js"
      ],
      "ignoreDependencies": ["@earendil-works/pi-ai"]
    },
    "apps/cli": {
      "ignoreBinaries": ["scutil", "hostnamectl"],
      "ignoreDependencies": ["@noble/ciphers", "@noble/curves", "@noble/hashes"]
    }
  }
}

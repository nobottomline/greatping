{
  "name": "greatping",
  "version": "0.4.0",
  "description": "Get an alert on your phone when your coding agent needs you",
  "keywords": [
    "cli",
    "agents",
    "claude-code",
    "codex",
    "mcp",
    "notifications",
    "push"
  ],
  "homepage": "https://github.com/nobottomline/greatping#readme",
  "bugs": {
    "url": "https://github.com/nobottomline/greatping/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobottomline/greatping.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "Great Love",
  "type": "module",
  "bin": {
    "greatping": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --experimental-transform-types --no-warnings --import ./test/ts-resolve.mjs --test test/*.test.mjs",
    "test:interactive": "python3 test/interactive-smoke.py && python3 test/terminal-smoke.py",
    "test:package": "pnpm build && node test/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.0",
    "toqr": "0.1.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@greatping/protocol": "workspace:*",
    "@types/node": "^22.13.11",
    "@types/ws": "^8.18.2",
    "tsdown": "0.23.0",
    "typescript": "~5.9.3"
  }
}
